{
  "name": "pokedex-web",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://mivanpv.github.io/diablito-systems.pokedex",
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.28.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@types/jest": "^27.5.2",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "cypress": "^16.1.1",
    "gh-pages": "^6.2.0",
    "postcss": "^8.4.49",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "^3.4.17",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build --nojekyll",
    "start:e2e": "cross-env BROWSER=none PORT=3000 react-scripts start",
    "cy:open": "cypress open --e2e",
    "cy:run": "cypress run --e2e --browser chrome",
    "test:e2e": "start-server-and-test start:e2e http-get://127.0.0.1:3000/diablito-systems.pokedex/ cy:run",
    "manual:capturas": "start-server-and-test start:e2e http-get://127.0.0.1:3000/diablito-systems.pokedex/ \"cypress run --config-file cypress.manual.config.ts --browser chrome\"",
    "manual:pdf": "node scripts/manual-pdf.js",
    "manual:video": "node scripts/manual-video.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
